# Copy to .env. Never commit .env.
PORT=7777
# Optional: GM key. With it, /gm asks for this key (same login as the Cloudflare edition).
# Use a long random phrase. The GM link printed at start keeps working either way.
GM_KEY=
# Content pack folder (absolute or relative to repo root)
PACK_DIR=packs/demo
# Optional: enables AI-written lines. Without it the tool is fully playable.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Hard cap of AI calls per session
AI_MAX_CALLS=30

# Optional: item art generation (tools/gen_images.mjs)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Optional: the System voice via ElevenLabs (server side only, never sent to a browser).
# Without it the GM desk speaks with the browser voice. ElevenLabs bills by characters.
ELEVENLABS_API_KEY=
# Optional: default voice (a premade voice id from your ElevenLabs account; pick one in Settings → Voice instead)
ELEVENLABS_VOICE_ID=
# Optional: model (default eleven_multilingual_v2; eleven_flash_v2_5 is faster and cheaper per character)
ELEVENLABS_MODEL_ID=
# Voice cache size in MB (data/tts/, least recently used lines are dropped first)
TTS_CACHE_MB=200
