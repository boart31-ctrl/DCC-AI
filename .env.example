# Copy to .env. Never commit .env.
PORT=7777
# Content pack folder (absolute or relative to repo root)
PACK_DIR=packs/demo
# Optional: enables AI-written lines. Without it the tool is fully playable.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Hard cap of AI calls per session
AI_MAX_CALLS=30

# Optional: item art generation (tools/gen_images.mjs)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium
