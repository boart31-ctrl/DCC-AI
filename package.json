{
  "name": "the-system",
  "version": "0.1.0",
  "private": true,
  "description": "Free, local-first game-show AI for tabletop RPG nights",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test server/test/*.test.js",
    "test:cloud": "node tools/e2e_cloud.mjs",
    "build:cloud": "node tools/build_cloud.mjs packs/demo dist-cloud",
    "dev:cloud": "npm run build:cloud && wrangler dev --config dist-cloud/wrangler.jsonc"
  },
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
